# Copy this file to .env and fill in the values from the Azure portal.
# .env is in .gitignore and must NEVER be committed.

# --- Azure OpenAI -----------------------------------------------------------
# Portal > workrights-openai > Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://workrights-openai.openai.azure.com
AZURE_OPENAI_KEY=

# These are DEPLOYMENT names (what you typed in Foundry), not model names.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Search --------------------------------------------------------
# Portal > workrights-search > Overview (Url) and Settings > Keys
AZURE_SEARCH_ENDPOINT=https://workrights-search.search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=workrights

# --- Public demo limits (server) -------------------------------------------
# Only these origins may call /api/ask. Leave unset in development.
# CLIENT_ORIGIN=https://your-site.vercel.app
DAILY_QUESTION_CAP=300
VISITOR_QUESTION_LIMIT=15
VISITOR_WINDOW_MINUTES=10

# --- Free provider (Groq chat + Gemini embeddings) -------------------------
# console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
FREE_SEARCH_INDEX=workrights-free

# Which bundle visitors get: azure | free
DEFAULT_PROVIDER=azure

# --- Admin login -----------------------------------------------------------
# Generate all three with: npm run admin:hash
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
